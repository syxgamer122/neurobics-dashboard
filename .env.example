# Sao chep file nay thanh `.env` roi dien gia tri that. `.env` da nam trong
# .gitignore — TUYET DOI khong commit.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Lay tai: Supabase Dashboard > Project Settings > API
#   VITE_SUPABASE_URL       = "Project URL"
#   VITE_SUPABASE_ANON_KEY  = "Project API keys" > anon / public
#
# Tren Vercel: Settings > Environment Variables, nho tick ca 3 moi truong
# Production / Preview / Development.
#
# Anon key di ve trinh duyet la BINH THUONG (RLS moi la lop chan thuc su),
# nhung de o .env thay vi hardcode trong repo thi moi rotate duoc key va moi
# tach duoc du an dev / staging / production.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Dung sb_publishable_... (khuyen nghi) hoac anon JWT cu. TUYET DOI khong dat
# sb_secret_... o day: bien VITE_ se bi dong vao bundle va lo cho trinh duyet.
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# Site key (public) cua widget chong bot o man hinh dang ky / khoi phuc.
# Secret key tuong ung duoc set phia Edge Function: TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key

# ─── Telemetry (tuy chon) ────────────────────────────────────────────────────
# Mac dinh gui ve <VITE_SUPABASE_URL>/functions/v1/server/telemetry.
# VITE_TELEMETRY_ENDPOINT=
# VITE_TELEMETRY_SAMPLE=1
# VITE_TELEMETRY_OFF=1
