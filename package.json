{
  "name": "mindgem-dashboard",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "pnpm exec tsc -p tsconfig.json && pnpm exec tsc -p tsconfig.worker.json",
    "build": "pnpm run typecheck && vite build",
    "build:only": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:sim": "node --experimental-strip-types tests/sim-client.ts && node --experimental-strip-types tests/sim-games.ts && node --experimental-strip-types tests/sim-audit.ts && node --experimental-strip-types tests/sim-anticheat.ts && node --experimental-strip-types tests/sim-ledger.ts",
    "test:rls": "node --experimental-strip-types tests/sim-rls.ts",
    "scan": "node tests/scan.mjs",
    "lint": "pnpm exec eslint . --max-warnings=0",
    "lint:fix": "pnpm exec eslint . --fix",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "check:bundle": "node tools/check-bundle.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run scan && pnpm run db:lint && pnpm run test:coverage && pnpm run test:sim && pnpm run build:only && pnpm run check:bundle && pnpm run security:audit",
    "test:coverage": "vitest run --coverage",
    "db:lint": "node tools/check-migrations.mjs",
    "db:normalize": "node tools/normalize-migrations.mjs",
    "db:baseline": "node tools/baseline-migrations.mjs",
    "db:push": "npx --yes supabase db push",
    "db:status": "npx --yes supabase migration list --linked",
    "db:drift": "npx --yes supabase db diff --use-migra",
    "functions:deploy": "npx --yes supabase functions deploy server",
    "reinstall": "powershell -Command \"Remove-Item -Recurse -Force node_modules; pnpm install --frozen-lockfile\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.2",
    "sonner": "2.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "26.1.0",
    "prettier": "^3.0.0",
    "puppeteer": "^25.5.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "3.2.4",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "workspaces": [
    "."
  ]
}
