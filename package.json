{
  "name": "mindgem-dashboard",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "pnpm run typecheck && vite build",
    "build:only": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "node --experimental-strip-types tests/sim-client.ts && node --experimental-strip-types tests/sim-games.ts && node --experimental-strip-types tests/sim-audit.ts",
    "scan": "node tests/scan.mjs",
    "check": "pnpm run typecheck && node tests/scan.mjs && vitest run && pnpm run test:sim"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.9",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.2",
    "sonner": "2.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
